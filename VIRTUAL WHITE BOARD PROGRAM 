import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.util.ArrayList;
public class VirtualWhiteboard extends JFrame {
 private final DrawPanel drawPanel;
 public VirtualWhiteboard() {
 setTitle("Virtual Whiteboard");
 setSize(800, 600);
 setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
 setLocationRelativeTo(null);
 drawPanel = new DrawPanel();
 JButton clearButton = new JButton("Clear Board");
 clearButton.addActionListener(e -> drawPanel.clearBoard());
 JPanel topPanel = new JPanel();
 topPanel.add(clearButton);
 add(topPanel, BorderLayout.NORTH);
 add(drawPanel, BorderLayout.CENTER);
 setVisible(true);
 }
 class DrawPanel extends JPanel {
 private final ArrayList<Point> points = new ArrayList<>(); 
 DrawPanel() {
 setBackground(Color.WHITE);
 addMouseListener(new MouseAdapter() {
 public void mousePressed(MouseEvent e) {
 points.add(null); // start a new linepoints.add(e.getPoint());
 repaint();
 }
 });
 void clearBoard() {
 points.clear();
 repaint();
 }
 protected void paintComponent(Graphics g) {
 super.paintComponent(g);
 g.setColor(Color.BLUE);
 addMouseMotionListener(new MouseMotionAdapter() {
 public void mouseDragged(MouseEvent e) {
 points.add(e.getPoint());
 repaint();
 }
 });
 }
 g.drawString("Draw here using your mouse", 20, 25);
 Point previous = null;
 for (Point point : points) {
 if (point == null) {
 previous = null;
 } else {
 if (previous != null) {
 g.drawLine(previous.x, previous.y,
 point.x, point.y);
 }
 previous = point;
 }
 }
 }
 }
 public static void main(String[] args) {
 SwingUtilities.invokeLater(VirtualWhiteboard::new);
