<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Virtual Whiteboard</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <!-- Sign in / register -->
  <section id="auth" class="screen">
    <form id="authForm" class="panel">
      <h1>Virtual Whiteboard</h1>
      <p class="sub">Sketch and plan together, live.</p>
      <label id="nameRow" hidden>Display name <input id="name" autocomplete="name"></label>
      <label>Email <input id="email" type="email" required autocomplete="email"></label>
      <label>Password <input id="password" type="password" minlength="8" required autocomplete="current-password"></label>
      <p id="authError" class="error" role="alert"></p>
      <button class="primary" id="authSubmit">Log in</button>
      <button type="button" class="link" id="authToggle">New here? Create an account</button>
    </form>
  </section>

  <!-- My boards -->
  <section id="boards" class="screen" hidden>
    <header class="bar">
      <strong>Your boards</strong>
      <span id="who"></span>
      <button id="logout" class="link">Log out</button>
    </header>
    <form id="newBoard" class="row">
      <input id="boardTitle" placeholder="Name a new board" required>
      <button class="primary">Create board</button>
    </form>
    <ul id="boardList" class="list"></ul>
  </section>

  <!-- Canvas -->
  <section id="room" class="screen" hidden>
    <header class="bar">
      <button id="back" class="link">Boards</button>
      <strong id="roomTitle"></strong>
      <span id="presence" class="presence"></span>
      <button id="share">Share</button>
      <button id="exportPng">Export PNG</button>
    </header>

    <nav class="tray" aria-label="Tools">
      <button data-tool="select" title="Pan (H)" class="tool">Pan</button>
      <button data-tool="pen" title="Pen (P)" class="tool on">Pen</button>
      <button data-tool="eraser" title="Eraser (E)" class="tool">Erase</button>
      <button data-tool="line" title="Line" class="tool">Line</button>
      <button data-tool="rect" title="Rectangle (R)" class="tool">Rect</button>
      <button data-tool="ellipse" title="Ellipse" class="tool">Oval</button>
      <button data-tool="text" title="Text (T)" class="tool">Text</button>
      <hr>
      <input type="color" id="color" value="#1d2733" aria-label="Colour">
      <input type="range" id="size" min="1" max="24" value="4" aria-label="Thickness">
      <hr>
      <button id="undo" title="Ctrl+Z">Undo</button>
      <button id="redo" title="Ctrl+Shift+Z">Redo</button>
      <button id="clear">Clear</button>
    </nav>

    <canvas id="canvas"></canvas>
    <div id="cursors"></div>
    <p id="toast" role="status" hidden></p>
  </section>

  <script src="app.js"></script>
</body>
</html>
