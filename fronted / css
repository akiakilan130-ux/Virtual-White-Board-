:root{
  --board:#f7f9fa; --ink:#1d2733; --tray:#26323f; --tray-ink:#e9eef3;
  --marker:#2b59ff; --line:#d5dde4; --danger:#c8372d;
  --font:"Trebuchet MS","Segoe UI",system-ui,sans-serif;
}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{font-family:var(--font);color:var(--ink);background:var(--board)}
[hidden]{display:none!important}
button,input{font:inherit}
button{cursor:pointer;border:1px solid var(--line);background:#fff;color:var(--ink);padding:.45rem .8rem;border-radius:6px}
button:focus-visible,input:focus-visible{outline:3px solid var(--marker);outline-offset:2px}
button.primary{background:var(--marker);border-color:var(--marker);color:#fff}
button.link{border:0;background:none;color:var(--marker);text-decoration:underline}
input:not([type=color]):not([type=range]){border:1px solid var(--line);border-radius:6px;padding:.55rem .7rem;width:100%}

.screen{min-height:100%}
#auth{display:grid;place-items:center;padding:1rem}
.panel{width:min(24rem,100%);background:#fff;border:1px solid var(--line);border-radius:10px;padding:1.6rem;display:grid;gap:.9rem}
.panel h1{margin:0;font-size:1.6rem;letter-spacing:-.02em}
.sub{margin:0;color:#5b6773}
label{display:grid;gap:.3rem;font-size:.9rem}
.error{color:var(--danger);min-height:1.2em;margin:0;font-size:.9rem}

.bar{display:flex;gap:.8rem;align-items:center;padding:.6rem 1rem;background:#fff;border-bottom:1px solid var(--line);height:3rem}
.bar #who,.bar .presence{margin-left:auto;color:#5b6773;font-size:.9rem}
.row{display:flex;gap:.6rem;max-width:36rem;margin:1.2rem auto;padding:0 1rem}
.list{list-style:none;max-width:36rem;margin:0 auto;padding:0 1rem;display:grid;gap:.5rem}
.list li{display:flex;align-items:center;gap:.6rem;background:#fff;border:1px solid var(--line);border-radius:8px;padding:.7rem .9rem}
.list li span{flex:1}
.list small{color:#5b6773}

#room{position:relative;height:100vh;overflow:hidden}
#canvas{position:absolute;left:0;top:3rem;width:100%;height:calc(100% - 3rem);touch-action:none;
  background-image:radial-gradient(var(--line) 1px,transparent 1px);background-size:24px 24px}
.presence{display:flex;gap:.3rem}
.presence i{width:1.5rem;height:1.5rem;border-radius:50%;display:grid;place-items:center;color:#fff;font:600 .75rem var(--font);font-style:normal}

.tray{position:absolute;z-index:3;left:.8rem;top:4rem;display:grid;gap:.35rem;padding:.5rem;
  background:var(--tray);border-radius:10px;width:4.4rem}
.tray button{background:transparent;border:1px solid transparent;color:var(--tray-ink);padding:.4rem .2rem;font-size:.85rem}
.tray .tool.on{background:var(--marker);border-color:var(--marker)}
.tray hr{width:100%;border:0;border-top:1px solid #455364;margin:.2rem 0}
.tray input[type=color]{width:100%;height:2rem;border:0;background:none;padding:0}
.tray input[type=range]{width:100%}

#cursors{position:absolute;left:0;top:3rem;width:100%;height:calc(100% - 3rem);pointer-events:none;overflow:hidden}
.cur{position:absolute;left:0;top:0;font-size:.75rem;color:#fff;padding:.1rem .4rem;border-radius:0 8px 8px 8px;white-space:nowrap}
#toast{position:absolute;bottom:1rem;left:50%;transform:translateX(-50%);background:var(--ink);color:#fff;padding:.5rem .9rem;border-radius:6px;z-index:5}

@media (max-width:768px){
  .tray{top:auto;bottom:.6rem;left:.6rem;right:.6rem;width:auto;grid-auto-flow:column;overflow-x:auto}
  .tray hr{width:1px;height:auto;border-top:0;border-left:1px solid #455364}
  .tray input[type=color]{width:2.4rem}.tray input[type=range]{width:6rem}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
